# Copy to .env.local and fill in. Restart `npm run dev` after changes.
# VITE_* is public (browser). Everything else is server-only — never prefix secrets with VITE_.

# Stripe — https://dashboard.stripe.com/apikeys  (Test mode first)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_
STRIPE_SECRET_KEY=sk_test_

# PayPal — https://developer.paypal.com/dashboard/applications
VITE_PAYPAL_CLIENT_ID=

# WalletConnect — https://cloud.walletconnect.com
VITE_WALLETCONNECT_PROJECT_ID=

# Studio USDT treasury (Polygon or Arbitrum). Leave empty to sign-only.
VITE_STUDIO_USDT_WALLET=

# Pass signing. Generate with: openssl rand -hex 32
TICKET_SECRET=

# Confirmation email. Use one provider. From address must be verified.
BOOKING_FROM_EMAIL=Venom Tattoos <bookings@yourdomain.com>
RESEND_API_KEY=
# SENDGRID_API_KEY=
# POSTMARK_SERVER_TOKEN=
