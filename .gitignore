cat > .gitignore <<'EOF'
# Dependencies
node_modules/

# Environment variables and secrets
.env
.env.*
!.env.example

# Build outputs
dist/
build/
.output/
.vercel/
.turbo/
coverage/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Operating system and editor files
.DS_Store
Thumbs.db
.vscode/
.idea/

# Temporary files
*.tmp
*.swp
EOF